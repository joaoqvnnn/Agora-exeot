# ============================================
# 🔐 .ENV.EXAMPLE — Larizinha Store
# ============================================
# Este arquivo é um MODELO. Ele mostra QUAIS variáveis
# o sistema precisa, mas SEM valores reais.
#
# ⚠️ IMPORTANTE:
#   - O arquivo real (.env) NÃO vai pro GitHub
#   - No Render, configure direto no painel "Environment"
#   - NUNCA coloque token real neste arquivo
# ============================================


# --------------------------------------------
# 🚀 AMBIENTE
# --------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo


# --------------------------------------------
# 🗄️ BANCO DE DADOS (Neon.tech)
# --------------------------------------------
# Connection string completa que o Neon te deu
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require


# --------------------------------------------
# 🤖 BOT TELEGRAM — CLIENTE
# --------------------------------------------
# Token do bot que atende os clientes (do @BotFather)
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Username do bot (sem @)
TELEGRAM_BOT_USERNAME=meu_bot_cliente

# ID do admin principal (dono) — pegue falando com @userinfobot
TELEGRAM_OWNER_ID=000000000

# URL pública do bot no Render
TELEGRAM_WEBHOOK_URL=https://seu-servico.onrender.com

# Segredo do webhook (string aleatória longa — o Render gera automaticamente)
TELEGRAM_WEBHOOK_SECRET=troque_por_string_aleatoria_longa


# --------------------------------------------
# 🤖 BOT TELEGRAM — ADMIN
# --------------------------------------------
# Token do bot separado pra painel admin
TELEGRAM_ADMIN_BOT_TOKEN=0000000000:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Username do bot admin (sem @)
TELEGRAM_ADMIN_BOT_USERNAME=meu_bot_admin

# URL pública do webhook do admin
TELEGRAM_ADMIN_WEBHOOK_URL=https://seu-servico-admin.onrender.com

# Segredo do webhook admin
TELEGRAM_ADMIN_WEBHOOK_SECRET=troque_por_outra_string_aleatoria


# --------------------------------------------
# 📢 CANAL OBRIGATÓRIO
# --------------------------------------------
# ID do canal/grupo que o usuário PRECISA entrar
# Formato: -1001234567890 (canal) ou -123456789 (grupo)
TELEGRAM_REQUIRED_CHANNEL_ID=-1000000000000

# Link do canal (o que o botão vai abrir)
TELEGRAM_REQUIRED_CHANNEL_LINK=https://t.me/seu_canal


# --------------------------------------------
# 💳 MERCADO PAGO
# --------------------------------------------
# Access Token do Mercado Pago (produção)
# Pega em: https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxx

# Public Key (usado no front do Mini App)
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Segredo do webhook (você configura no painel do Mercado Pago)
MERCADOPAGO_WEBHOOK_SECRET=troque_por_string_do_mercado_pago

# URL que o Mercado Pago vai chamar quando o Pix for pago
MERCADOPAGO_WEBHOOK_URL=https://seu-servico.onrender.com/webhooks/mercadopago


# --------------------------------------------
# 📧 E-MAIL (SMTP)
# --------------------------------------------
# Servidor SMTP (Gmail, Zoho, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Usuário (geralmente o e-mail completo)
SMTP_USER=seuemail@gmail.com

# Senha de app (Gmail exige "senha de app", não a senha normal)
# Gere em: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=sua_senha_de_app_aqui

# Nome que aparece como remetente
SMTP_FROM_NAME=Larizinha Store

# E-mail remetente
SMTP_FROM_EMAIL=seuemail@gmail.com

# Usar TLS? (Gmail = true, porta 587)
SMTP_USE_TLS=true


# --------------------------------------------
# 🤖 OPENAI (IA do atendimento)
# --------------------------------------------
# Chave da API da OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo padrão (gpt-4o-mini é barato e bom)
OPENAI_MODEL=gpt-4o-mini

# Limite de tokens por resposta
OPENAI_MAX_TOKENS=500

# Temperatura (0 = objetivo, 1 = criativo)
OPENAI_TEMPERATURE=0.7


# --------------------------------------------
# 📱 WHATSAPP (Baileys — serviço Node.js)
# --------------------------------------------
# URL pública do serviço Baileys no Render
# Ex: https://larizinha-whatsapp.onrender.com
WHATSAPP_API_URL=https://seu-baileys.onrender.com

# API key que o Baileys espera (mesma configurada lá)
# Você inventa uma string aleatória longa
WHATSAPP_API_KEY=troque_por_string_aleatoria_longa

# Número do WhatsApp (formato internacional, apenas dígitos)
WHATSAPP_PHONE_NUMBER=5511999999999

# Secret usado pra validar webhooks do Baileys
# (mesma string configurada no serviço Node.js)
WHATSAPP_WEBHOOK_SECRET=troque_por_outra_string_aleatoria


# --------------------------------------------
# 🔐 SEGURANÇA / SESSÃO
# --------------------------------------------
# Chave secreta pra assinar JWT (painel web)
# Gere uma string aleatória longa (min 32 chars):
# Exemplo no terminal: openssl rand -hex 32
SECRET_KEY=troque_por_string_aleatoria_muito_longa_64_caracteres

# Algoritmo do JWT
JWT_ALGORITHM=HS256

# Tempo de expiração da sessão (minutos)
JWT_EXPIRE_MINUTES=1440


# --------------------------------------------
# 🛡️ ANTI-FLOOD
# --------------------------------------------
# Padrão inicial (o admin pode mudar pelo painel)
ANTIFLOOD_MAX_MESSAGES=20
ANTIFLOOD_WINDOW_SECONDS=10
ANTIFLOOD_BLOCK_SECONDS=600


# --------------------------------------------
# 🌐 URLS DO SISTEMA
# --------------------------------------------
# URL base do sistema (Render)
BASE_URL=https://seu-servico.onrender.com

# URL do Mini App (loja)
WEBAPP_URL=https://seu-servico.onrender.com/webapp

# URL do site de ativação de produto (por e-mail)
ACTIVATION_URL=https://seu-servico.onrender.com/webapp/activate


# --------------------------------------------
# 📲 WHATSAPP FLOW (ativação via link)
# --------------------------------------------
# Exigir senha de saque pra ativar via WhatsApp?
WA_FLOW_REQUIRE_PASSWORD=true

# Enviar link direto no WhatsApp? (ou só avisar)
WA_FLOW_SHOW_LINK_DIRECT=true

# Dias que o link de ativação do WhatsApp fica válido
WA_FLOW_LINK_DAYS=30

# Tentativas de senha na ativação via WhatsApp
WA_FLOW_MAX_ATTEMPTS=5

# Minutos de bloqueio após exceder tentativas
WA_FLOW_LOCKOUT_MINUTES=30


# --------------------------------------------
# 📊 LOGS / SUPORTE
# --------------------------------------------
# ID do canal/grupo onde os logs de venda vão aparecer
LOGS_CHANNEL_ID=-1000000000000

# Link do suporte (WhatsApp ou Telegram)
SUPPORT_LINK=https://wa.me/5511999999999


# ============================================
# 📝 OBSERVAÇÕES FINAIS
# ============================================
# 1. Todos os valores acima são de EXEMPLO
# 2. Copie este arquivo para ".env" e preencha
# 3. Ou (melhor) configure direto no painel do Render
# 4. NUNCA comite o ".env" real no GitHub
# 5. Tokens/API keys: pegue sempre do painel oficial
#    - BotFather (Telegram)
#    - Mercado Pago Developers
#    - OpenAI Platform
#    - Google Account (senha de app)
# 6. Se um token vazar, REVOQUE IMEDIATAMENTE
# ============================================

# ============================================
# FIM
# ============================================
